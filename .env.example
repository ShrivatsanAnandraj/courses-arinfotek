# Neon Database URL - SHARED with the assessment app (arinfotek-assesment).
# Both apps MUST point to the same database for tests to appear for students.
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require

# JWT Secret (for authentication)
JWT_SECRET=your-secret-key-here

# OneCompiler API Key (for advanced Python execution - file I/O, os, subprocess, etc.)
# Get free key at: https://onecompiler.com/developers
ONECOMPILER_API_KEY=your-onecompiler-api-key-here

# URL of the assessment app (used for Take Test / Make Question Paper deep links)
VITE_ASSESSMENT_URL=https://assessment.arinfotek.co.in